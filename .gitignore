# generated / local
dist/
deps/
runs/
.env
.DS_Store

# large media: the manifest, sidecars, and transcripts are the record
recordings/**/*.m4a
recordings/**/*.mp3
recordings/**/*.wav
recordings/**/*.aiff
recordings/**/*.aif
recordings/**/*.caf
recordings/**/*.qta
recordings/.whisper*

# raw photo drop and full-size filed copies: tracked once cleaned/downscaled
photos/PXL_*
photos/event/
talks/*/photos/

# local harness config
.claude/

# package-manager caches
node_modules/
.bun-cache/
.npm-cache/

# BEGIN conference build data
# The upstream template ignores one conference's build. A fork deletes this
# whole block so its own brief/, state/, talks/ and artifacts are tracked.
# See .agents/skills/conference-init/SKILL.md.
/brief/
/site/
/state/
/talks/
/recordings/inbox/*
!/recordings/inbox/.gitkeep
/photos/*
!/photos/README.md
!/photos/.gitkeep
/analysis/
/notes/inbox/*
!/notes/inbox/.gitkeep
/notes/research/*
!/notes/research/.gitkeep
/editorial/backlog.md
/editorial/hooks/*
!/editorial/hooks/.gitkeep
/explainers/*/
!/explainers/runtime/
/atlases/*/
!/atlases/runtime/
/magazine/*/
# END conference build data
