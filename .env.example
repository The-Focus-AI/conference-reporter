# Copy to .env and set the one conference this build tracks.
CONFERENCE_URL=
RECORDINGS_INBOX=recordings/inbox

# Optional: override the recording window (defaults to the tracked conference's
# dates, padded one day either side). Set both or neither.
# RECORDINGS_SINCE=<YYYY-MM-DD>
# RECORDINGS_UNTIL=<YYYY-MM-DD>

# Optional: local speech-to-text for recordings Voice Memos did not transcribe.
# RECORDINGS_ASR=auto            # auto | apple | qwen
# RECORDINGS_ASR_ON_BATTERY=defer  # defer (default) | allow
# QWEN_ASR_DIR=~/src/qwen-asr    # holds the qwen_asr binary
# QWEN_ASR_MODEL=qwen3-asr-1.7b  # model directory inside it, or an absolute path
# QWEN_ASR_CHUNK_SECONDS=300     # chunk length; long single passes break down
# QWEN_ASR_CACHE=~/.cache/focus-conference/qwen-asr  # finished chunks, for resume

# Optional: photo drop folder (default: photos)
# PHOTOS_DIR=photos
